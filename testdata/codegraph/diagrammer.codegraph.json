      },
      {
        "id": "d.s2.s3",
        "from": "stage2",
        "to": "stage3",
        "kind": "use",
        "name": "validated model"
      },
      {
        "id": "d.s3.s4",
        "from": "stage3",
        "to": "stage4",
        "kind": "use",
        "name": "documents"
      },
      {
        "id": "d.s2.schema",
        "from": "stage2",
