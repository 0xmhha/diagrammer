          },
          {
            "name": "validate",
            "signature": "validate(model) error"
          },
          {
            "name": "compose",
            "signature": "compose(model) []Document"
          },
          {
            "name": "render",
            "signature": "render(document) Page"
          }
        ]
      },
      {
        "id": "Analyzer",
        "name": "Analyzer",
        "operations": [
          {
            "name": "Language",
            "signature": "Language() graph.Language"
          },
          {
            "name": "Analyze",
            "signature": "Analyze(ctx, root, opts) (*graph.Graph, error)"
          }
        ]
      }
    ],
    "dependencies": [
      {
        "id": "d.cli",
        "from": "cli",
        "to": "command",
        "kind": "use"
      },
      {
        "id": "d.mcp",
        "from": "mcp",
        "to": "command",
        "kind": "use"
      },
      {
        "id": "d.cmd.pipe",
        "from": "command",
        "to": "pipeline",
        "kind": "use",
