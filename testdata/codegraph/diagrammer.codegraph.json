{
  "schemaVersion": 1,
  "meta": {
    "title": "diagrammer",
    "subtitle": "Read from its own code graph: 14 packages, 435 nodes, 383 edges"
  },
  "provenance": {
    "origin": "modelReviewed",
    "note": "Produced by a model reading a stage-1 graph of this repository, then kept as a fixture because it is the first document that was not written to please the composer. It found two defects on its first run. It is the densest model committed here and the one the drawn-ratio floor is measured against."
  },
  "families": [
    "component",
    "sequence",
    "state",
    "usecase"
  ],
  "component": {
    "components": [
      {
        "id": "cli",
        "name": "CLI",
        "stereotype": "surface",
        "ports": [
          {
            "id": "cli.r.ops",
            "kind": "required",
            "interface": "Capabilities"
          }
        ]
      },
      {
        "id": "mcp",
        "name": "MCP server",
        "stereotype": "surface",
        "ports": [
          {
            "id": "mcp.r.ops",
            "kind": "required",
            "interface": "Capabilities"
          }
        ]
      },
      {
        "id": "command",
