          }
        ]
      },
      {
        "id": "stage2",
        "name": "validate",
        "parent": "pipeline",
        "stereotype": "boundary"
      },
      {
        "id": "stage3",
        "name": "compose",
        "parent": "pipeline",
        "stereotype": "stage"
      },
      {
        "id": "stage4",
        "name": "render",
        "parent": "pipeline",
        "stereotype": "stage"
      },
      {
        "id": "goast",
        "name": "Go analyzer",
        "stereotype": "analyzer",
        "ports": [
          {
            "id": "goast.p.analyzer",
            "kind": "provided",
            "interface": "Analyzer"
          }
        ]
      },
      {
        "id": "invariant",
        "name": "Rules",
        "stereotype": "checker"
      },
      {
        "id": "contracts",
        "name": "Contracts",
        "stereotype": "subsystem"
      },
      {
        "id": "schemas",
        "name": "Embedded schemas",
        "parent": "contracts"
      },
      {
        "id": "graphType",
        "name": "Code graph",
        "parent": "contracts"
      },
      {
        "id": "umlType",
        "name": "UML model",
        "parent": "contracts"
      },
      {
        "id": "diagramType",
        "name": "Diagram source",
        "parent": "contracts"
      },
      {
        "id": "artifactType",
        "name": "Drawn page",
        "parent": "contracts"
      }
    ],
    "interfaces": [
      {
