        "effect": "rule: channel-capacity"
      },
      {
        "id": "t.rules",
        "from": "st.routed",
        "to": "st.drawn",
        "guard": "no rule refuses it on its own"
      },
      {
        "id": "t.bad",
        "from": "st.routed",
        "to": "st.recorded",
        "guard": "a rule refuses it",
